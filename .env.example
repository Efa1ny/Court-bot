# Скопируйте файл в .env и заполните значения для собственного сервера.
# Никогда не публикуйте .env и ключ сервисного аккаунта.
DISCORD_TOKEN=replace_me
TEST_GUILD_ID=
ALLOWED_ROLE_IDS=

TEMPLATES_DIR=templates
DATABASE_PATH=data/court_bot.db

# Для мониторинга установите 1 и заполните все ID ниже.
FORUM_MONITOR_ENABLED=0
FORUM_ALERT_CHANNEL_ID=
ROLE_SUPREME_CHAIR_ID=
ROLE_SUPREME_JUDGE_ID=
ROLE_FEDERAL_CHAIR_ID=
ROLE_FEDERAL_JUDGE_ID=
ROLE_JUDICIAL_CORPS_ID=

# ID своей Google Таблицы и путь к JSON-ключу сервисного аккаунта вне Git.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
